:root {
  --bg: #090e1a;
  --panel: #111827;
  --card: #182235;
  --border: #263248;
  --text: #f1f5f9;
  --muted: #94a3b8;
  --cyan: #06b6d4;
  --cyan-light: #67e8f9;
  --danger: #f43f5e;
  --warn: #f59e0b;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html,
body,
#root {
  margin: 0;
  padding: 0;
  height: 100dvh;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
}

.app-shell {
  display: flex;
  flex-direction: column;
  height: 100dvh;
  width: 100%;
}

.header {
  flex-shrink: 0;
  background: rgba(17, 24, 39, 0.96);
  border-bottom: 1px solid var(--border);
  padding: max(0.5rem, env(safe-area-inset-top)) 0.75rem 0.65rem;
}

.container {
  width: 100%;
  max-width: 760px;
  margin: 0 auto;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.brand-title {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-weight: 800;
  font-size: 1rem;
  color: var(--cyan-light);
}

.badge-pro {
  background: rgba(6, 182, 212, 0.16);
  color: var(--cyan-light);
  font-size: 0.65rem;
  padding: 0.15rem 0.4rem;
  border-radius: 6px;
}

.brand-owner {
  font-size: 0.7rem;
  color: var(--muted);
  margin: 0.1rem 0 0;
}

.actions-row {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  height: 44px;
  padding: 0 0.65rem;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  font-weight: 700;
  font-size: 0.8rem;
  cursor: pointer;
}

.icon-btn.cyan-text {
  color: var(--cyan-light);
}

.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
  margin-top: 0.65rem;
}

.tab-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  min-height: 44px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--muted);
  font-weight: 600;
  font-size: 0.875rem;
  cursor: pointer;
}

.tab-btn.active {
  background: var(--cyan);
  border-color: var(--cyan);
  color: #04131c;
}

.main-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100%;
  max-width: 760px;
  margin: 0 auto;
}

.scroll-area {
  flex: 1;
  overflow-y: auto;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.welcome-box {
  margin: auto 0;
  text-align: center;
  padding: 1rem 0.5rem;
}

.welcome-icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 0.75rem;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6, 182, 212, 0.14);
  border: 1px solid rgba(6, 182, 212, 0.35);
  color: var(--cyan);
}

.welcome-box h1 {
  margin: 0;
  font-size: 1.25rem;
}

.tagline {
  color: var(--cyan-light);
  font-size: 0.8rem;
  margin: 0.3rem 0;
}

.subtitle {
  color: var(--muted);
  font-size: 0.875rem;
  margin: 0.35rem auto 1.25rem;
  max-width: 360px;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 0.6rem;
}

.quick-btn {
  min-height: 48px;
  padding: 0.7rem 0.85rem;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  font-size: 0.8rem;
  text-align: start;
  cursor: pointer;
}

.msg-row {
  display: flex;
  gap: 0.6rem;
  align-items: flex-start;
}

.msg-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--cyan);
}

.msg-row.user .avatar {
  background: rgba(6, 182, 212, 0.16);
  border-color: rgba(6, 182, 212, 0.4);
  color: var(--cyan-light);
}

.bubble {
  max-width: 85%;
  border-radius: 16px;
  padding: 0.75rem 0.95rem;
  background: var(--card);
  border: 1px solid var(--border);
  font-size: 0.95rem;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.msg-row.user .bubble {
  background: rgba(8, 145, 178, 0.22);
  border-color: rgba(6, 182, 212, 0.35);
}

.msg-img {
  max-height: 220px;
  max-width: 100%;
  border-radius: 10px;
  margin-bottom: 0.5rem;
  display: block;
}

.sources-box {
  margin-top: 0.75rem;
  padding-top: 0.6rem;
  border-top: 1px solid var(--border);
}

.sources-title {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--cyan-light);
  margin-bottom: 0.4rem;
}

.source-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.55rem 0.65rem;
  margin-top: 0.35rem;
  border-radius: 8px;
  background: rgba(9, 14, 26, 0.7);
  color: var(--cyan-light);
  text-decoration: none;
  font-size: 0.78rem;
}

.source-link span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 0.5rem;
  padding-top: 0.4rem;
  border-top: 1px solid rgba(38, 50, 72, 0.7);
}

.speak-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 36px;
  padding: 0.25rem 0.6rem;
  border-radius: 8px;
  border: none;
  background: transparent;
  color: var(--muted);
  font-size: 0.78rem;
  cursor: pointer;
}

.composer {
  flex-shrink: 0;
  background: rgba(17, 24, 39, 0.98);
  border-top: 1px solid var(--border);
  padding: 0.6rem 0.75rem max(0.75rem, env(safe-area-inset-bottom));
}

.tools-bar {
  display: flex;
  gap: 0.45rem;
  overflow-x: auto;
  margin-bottom: 0.5rem;
}

.tool-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  flex-shrink: 0;
  min-height: 38px;
  padding: 0 0.75rem;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  font-size: 0.78rem;
  cursor: pointer;
}

.tool-chip.active {
  border-color: var(--cyan);
  background: rgba(6, 182, 212, 0.18);
  color: var(--cyan-light);
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 0.45rem;
}

.text-input {
  flex: 1;
  min-height: 48px;
  max-height: 120px;
  resize: none;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  padding: 0.75rem 0.85rem;
  font-size: 0.95rem;
  font-family: inherit;
  outline: none;
}

.text-input:focus {
  border-color: var(--cyan);
}

.mic-btn,
.send-btn {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.mic-btn {
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
}

.mic-btn.listening {
  border-color: var(--danger);
  background: rgba(244, 63, 94, 0.2);
  color: #fda4af;
}

.send-btn {
  border: none;
  background: var(--cyan);
  color: #04131c;
}

.send-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.preview-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 0.5rem;
  padding: 0.25rem;
  border-radius: 12px;
  border: 1px solid rgba(6, 182, 212, 0.45);
  background: var(--card);
}

.preview-wrap img {
  height: 68px;
  border-radius: 8px;
  display: block;
}

.remove-img {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 26px;
  height: 26px;
  border-radius: 999px;
  border: none;
  background: var(--danger);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.banner {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  padding: 0.75rem;
  border-radius: 12px;
  font-size: 0.8rem;
  line-height: 1.45;
}

.banner.warn {
  background: rgba(245, 158, 11, 0.12);
  border: 1px solid rgba(245, 158, 11, 0.35);
  color: #fde68a;
}

.banner.error {
  background: rgba(244, 63, 94, 0.12);
  border: 1px solid rgba(244, 63, 94, 0.4);
  color: #fecdd3;
}

.hvac-card {
  background: var(--card);
  border: 1px solid rgba(6, 182, 212, 0.3);
  border-radius: 14px;
  padding: 0.9rem;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.65rem;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
}

.field label {
  display: block;
  font-size: 0.75rem;
  color: #cbd5e1;
  margin-bottom: 0.35rem;
}

.field input,
.field select,
.field textarea {
  width: 100%;
  min-height: 48px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text);
  padding: 0.65rem 0.75rem;
  font-size: 0.9rem;
  font-family: inherit;
  outline: none;
}

.field textarea {
  min-height: 84px;
  resize: vertical;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  min-height: 52px;
  border-radius: 12px;
  border: none;
  background: var(--cyan);
  color: #04131c;
  font-weight: 800;
  font-size: 0.95rem;
  cursor: pointer;
}

.primary-btn:disabled {
  opacity: 0.5;
}

.overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(4px);
  display: flex;
}

.drawer {
  width: 100%;
  max-width: 340px;
  height: 100%;
  background: var(--panel);
  border-inline-end: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: max(0.75rem, env(safe-area-inset-top)) 0.85rem 1rem;
}

.modal-wrap {
  align-items: flex-end;
  justify-content: center;
}

.modal {
  width: 100%;
  max-width: 440px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px 20px 0 0;
  padding: 1.1rem 1.1rem max(1.1rem, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

@media (min-width: 640px) {
  .modal-wrap {
    align-items: center;
  }
  .modal {
    border-radius: 20px;
  }
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.7rem;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--card);
}

.history-item.active {
  border-color: var(--cyan);
  background: rgba(6, 182, 212, 0.12);
}

.history-btn {
  flex: 1;
  min-width: 0;
  background: none;
  border: none;
  color: var(--text);
  text-align: start;
  cursor: pointer;
  padding: 0;
}

.history-title {
  font-size: 0.88rem;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-meta {
  font-size: 0.72rem;
  color: var(--muted);
  margin-top: 0.2rem;
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.hidden {
  display: none;
}
