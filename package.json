{
  "name": "said-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev": "concurrently \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
